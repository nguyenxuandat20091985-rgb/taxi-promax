{
  "version": 2,
  "name": "taxi-promax-he-thong-toan-quoc",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/khachhang.html", "destination": "/khachhang", "permanent": true },
    { "source": "/xeghep.html", "destination": "/xeghep", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin-dashboard", "destination": "/api/legacy?endpoint=admin-dashboard" },
    { "source": "/api/monitor", "destination": "/api/legacy?endpoint=monitor" },
    { "source": "/api/ride-allocation", "destination": "/api/legacy?endpoint=ride-allocation" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/khachhang", "destination": "/khachhang.html" },
    { "source": "/xeghep", "destination": "/xeghep.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
