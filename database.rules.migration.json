{
  "rules": {
    ".read": false,
    ".write": false,
    "drivers": {
      "$driverId": {
        ".read": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)",
        ".write": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)",
        "documents": {
          ".read": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)",
          ".write": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)"
        },
        "wallet": {
          ".read": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)",
          ".write": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)"
        }
      }
    },
    "customers": {
      "$customerId": {
        ".read": "auth != null && (auth.token.admin === true || auth.token.customerId === $customerId || auth.uid === $customerId)",
        ".write": "auth != null && (auth.token.admin === true || auth.token.customerId === $customerId || auth.uid === $customerId)"
      }
    },
    "datxe": {
      "$orderId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('customerId').val() === auth.token.customerId || data.child('driverId').val() === auth.token.driverId || newData.child('customerId').val() === auth.token.customerId || newData.child('driverId').val() === auth.token.driverId)",
        ".write": "auth != null && (auth.token.admin === true || data.child('customerId').val() === auth.token.customerId || data.child('driverId').val() === auth.token.driverId || newData.child('customerId').val() === auth.token.customerId || newData.child('driverId').val() === auth.token.driverId)",
        ".validate": "newData.hasChildren(['status', 'timestamp'])"
      }
    },
    "tai_xe_online": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === true || auth.token.driverId === $driverId || auth.uid === $driverId)"
      }
    },
    "chat": {
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chat_xg": {
      "$bookingId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "ratings": {
      "$orderId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "receipts": {
      "$receiptId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "sos": {
      "$sosId": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null"
      }
    },
    "emergencies": {
      "$emergencyId": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null"
      }
    },
    "shared_rides": {
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "shared_ride_bookings": {
      "$bookingId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "promos": {
      "$promoCode": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "payment_pending": {
      "$orderCode": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "payment_logs": {
      "$orderCode": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": "auth != null && auth.token.admin === true"
      }
    }
  }
}
