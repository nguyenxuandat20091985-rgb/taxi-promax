{
  "version": 1,
  "driver_lock": {
    "max_active_rides": 1,
    "block_new_orders_states": ["OFFERED", "ACCEPTED", "DRIVER_EN_ROUTE", "ARRIVED", "PASSENGER_ONBOARD", "IN_PROGRESS"]
  },
  "road_awareness": {
    "bridge_blocks_dispatch": true,
    "wrong_direction_threshold_degrees": 120,
    "off_route_progress_delta": 0.35,
    "require_valid_gps": true
  },
  "region_dispatch": {
    "enabled": true,
    "inputs": ["demand_supply_ratio", "queue_age", "distance_to_pickup", "road_accessibility", "service_zone", "driver_subscription_active"],
    "priority_is_advisory": true
  },
  "ai_guardrails": {
    "ai_can": ["rank_candidates", "forecast_demand", "detect_anomalies", "suggest_rebalancing"],
    "ai_cannot": ["confirm_payment", "change_fare", "bypass_subscription", "override_active_ride_lock", "force_ride_state", "make_legal_decision"]
  }
}
